{
  "name": "snes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "copy-engine": "node -e \"const fs=require('fs');fs.mkdirSync('public/engine',{recursive:true});fs.copyFileSync('node_modules/@wasm-gaming/snes9x-wasm/dist/snes9x/snes9x.js','public/engine/snes9x.js');fs.copyFileSync('node_modules/@wasm-gaming/snes9x-wasm/dist/snes9x/snes9x.wasm','public/engine/snes9x.wasm')\"",
    "dev": "npm run copy-engine && vite",
    "build": "npm run copy-engine && tsc && vite build",
    "preview": "npm run copy-engine && vite preview"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@wasm-gaming/engine-specs": "^0.3.2",
    "@wasm-gaming/snes9x-wasm": "^0.1.1",
    "jsqr": "^1.4.0",
    "nosleep.js": "^0.12.0",
    "peerjs": "^1.5.5",
    "qrcode-generator": "^1.5.2"
  }
}
